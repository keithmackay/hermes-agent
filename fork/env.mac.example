# Template for ~/.config/hermes-fork/env.mac (keep it OUTSIDE the repo, mode 600):
#   mkdir -p ~/.config/hermes-fork && cp fork/env.mac.example ~/.config/hermes-fork/env.mac
#   chmod 600 ~/.config/hermes-fork/env.mac
# Generate values with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
API_SERVER_KEY=change-me
# Claude Code login for agent-spawned `claude` runs. Generate on the host
# with `claude setup-token` (Pro/Max subscription).
# CLAUDE_CODE_OAUTH_TOKEN=
